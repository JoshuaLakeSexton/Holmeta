{
  "manifest_version": 3,
  "name": "Holmeta Productivity & Health Toolkit",
  "short_name": "HOLMETA",
  "version": "3.0.0",
  "description": "Privacy-first browser toolkit for reducing screen strain and improving focus. Local-first, browser-only.",
  "action": {
    "default_title": "HOLMETA",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "offscreen",
    "tabs",
    "activeTab",
    "windows",
    "scripting",
    "webRequest",
    "notifications",
    "alarms",
    "declarativeContent",
    "declarativeNetRequest"
  ],
  "optional_permissions": [
    "geolocation",
    "videoCapture",
    "bluetooth"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "src/content/appearance-comfort.css"
      ],
      "js": [
        "appearance/init-theme-toggle.js",
        "src/shared/storage.js",
        "src/content/media-protection.js",
        "src/content/comfort-overlays.js",
        "src/content/appearance-comfort.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "appearance/darklight-settings.js",
        "appearance/darklight-engine.js",
        "appearance/darklight-switch.js",
        "light/engine.js",
        "translate/engine.js",
        "insight/page-insight-engine.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.css",
        "blocked.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "minimum_chrome_version": "114"
}
